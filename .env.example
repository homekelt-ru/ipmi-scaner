# Скопируйте в .env и поправьте.

# Сети для сканирования (через пробел или запятую): CIDR, диапазоны, IP
IPMI_NETWORKS=192.168.1.0/24
# Интервал планового скана, минут (0 — только вручную)
IPMI_INTERVAL_MINUTES=60
IPMI_TIMEOUT=1.5
IPMI_RETRIES=1
IPMI_RATE=1000
IPMI_REDFISH=true

# Веб-панель. При IPMI_WEB_LISTEN=0.0.0.0 обязательно задайте пароль!
IPMI_WEB_LISTEN=127.0.0.1
IPMI_WEB_PORT=8623
IPMI_WEB_USERNAME=admin
IPMI_WEB_PASSWORD=
