# Скопируйте в .env и поправьте.

# Сети для сканирования (через пробел или запятую): CIDR, диапазоны, IP
IPMI_NETWORKS=192.168.1.0/24
# Интервал планового скана, минут (0 — только вручную)
IPMI_INTERVAL_MINUTES=60
IPMI_TIMEOUT=1.5
IPMI_RETRIES=1
IPMI_RATE=1000
IPMI_REDFISH=true

# Веб-панель. При IPMI_WEB_LISTEN=0.0.0.0 обязательно задайте пароль!
IPMI_WEB_LISTEN=127.0.0.1
IPMI_WEB_PORT=8623
IPMI_WEB_USERNAME=admin
IPMI_WEB_PASSWORD=

# Вход в BMC. Логин и пароль по умолчанию для BMC, у которых нет своих
# (свои задаются в панели, кнопка «войти» в строке сервера). Пусто — только свои.
# Сбор данных запускается вручную, одна попытка входа на BMC.
IPMI_BMC_USERNAME=
IPMI_BMC_PASSWORD=
IPMI_BMC_TIMEOUT=15
IPMI_BMC_MAX_PARALLEL=8

# Библиотека ISO-образов (каталог ./iso рядом с docker-compose.yml). BMC скачивает образы
# с этого сервиса по HTTP, поэтому порт должен быть доступен из сети BMC.
IPMI_ISO_PORT=8624
# Адрес сервиса, который увидит BMC; пусто — определяется автоматически
IPMI_ISO_HOST=
